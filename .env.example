PORT=4000
# Optional football-data.org free account key for the second crest provider.
FOOTBALL_DATA_API_KEY=
# TheSportsDB's documented free shared key.
THESPORTSDB_API_KEY=123
# PostgreSQL 18 runs locally on port 5433.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/fantasy_ucl_tracker
# Optional single tournament account. Generate the hash with: npm run auth:hash
TOURNAMENT_EMAIL=
TOURNAMENT_DISPLAY_NAME=Tournament Admin
TOURNAMENT_PASSWORD_HASH=
